<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="ElectronicArts.NBALIVE10"
            Publisher="CN=Electronic Arts Inc."
            Version="1.0.0.0"/>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <ExecutableList>
    <Executable Name="NBA LIVE 10.exe"
                Id="Game"
                Alias="NBALIVE10.exe"
                OverrideDisplayName="NBA LIVE 10"/>
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="NBA LIVE 10"
                PublisherDisplayName="Electronic Arts"
                StoreLogo="StoreLogo.png"
                Square150x150Logo="Logo.png"
                Square44x44Logo="SmallLogo.png"
                SplashScreenImage="SplashScreen.png"
                Description="EA SPORTS basketball, developed by EA Canada and first released on Xbox 360 in October 2009. Native PC recompilation of the Xbox 360 version; runs from your own copy of the game."
                BackgroundColor="#000000"
                ForegroundText="light"/>

  <DesktopRegistration>
    <DependencyList>
      <KnownDependency Name="VC14"/>
    </DependencyList>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
  </DesktopRegistration>
</Game>
