<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="@IDENTITY_NAME@"
            Publisher="CN=Electronic Arts Inc."
            Version="1.0.0.0"/>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <ExecutableList>
    <Executable Name="@DISPLAY_NAME@.exe"
                Id="Game"
                Alias="@IDENTITY_ALIAS@.exe"
                OverrideDisplayName="@DISPLAY_NAME@"/>
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="@DISPLAY_NAME@"
                PublisherDisplayName="Electronic Arts"
                StoreLogo="StoreLogo.png"
                Square150x150Logo="Logo.png"
                Square44x44Logo="SmallLogo.png"
                SplashScreenImage="SplashScreen.png"
                Description="EA SPORTS basketball, first released on Xbox 360 in @RELEASE_YEAR@. Native PC recompilation of the Xbox 360 version; runs from your own copy of the game."
                BackgroundColor="#000000"
                ForegroundText="light"/>

  <DesktopRegistration>
    <DependencyList>
      <KnownDependency Name="VC14"/>
    </DependencyList>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
  </DesktopRegistration>
</Game>
