#include <winver.h>

1 ICON "metadata/@PROJECT_NAME@.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Electronic Arts"
            VALUE "FileDescription", "@DISPLAY_NAME@"
            VALUE "ProductName", "@DISPLAY_NAME@"
            VALUE "LegalCopyright", "(c) @RELEASE_YEAR@ Electronic Arts Inc."
            VALUE "InternalName", "@PROJECT_NAME@"
            VALUE "OriginalFilename", "@DISPLAY_NAME@.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
